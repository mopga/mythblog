# Copy to .env and replace every placeholder. Never commit .env.
# Used by docker-compose.yml; path defaults below are for running the bare
# binary outside Docker (inside the container they are /data/*).
ODDITY_ADDR=127.0.0.1:8890
ODDITY_DB_PATH=./data/oddity.db
ADMIN_API_KEY=replace-with-a-unique-random-value
HERMES_API_KEY=replace-with-another-unique-random-value
EDITOR_USER=editor
EDITOR_PASSWORD=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_PATH=/admin
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/media
PUBLIC_BASE_URL=http://127.0.0.1:8890
MAX_UPLOAD_BYTES=10485760

# Required only when STORAGE_DRIVER=r2.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
